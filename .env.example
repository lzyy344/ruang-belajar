# =============================================================================
# Ruang Belajar - Environment Variables
# Copy ke .env.local (untuk development) atau set di Vercel/Railway dashboard
# =============================================================================

# -----------------------------------------------------------------------
# DATABASE (Railway PostgreSQL atau Supabase)
# -----------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/ruang_belajar?schema=public"

# -----------------------------------------------------------------------
# REDIS (Railway Redis atau Upstash)
# -----------------------------------------------------------------------
REDIS_URL="redis://default:password@host:6379"

# -----------------------------------------------------------------------
# NEXTAUTH (wajib)
# Generate secret: openssl rand -base64 32
# -----------------------------------------------------------------------
NEXTAUTH_SECRET="generate-dengan-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# -----------------------------------------------------------------------
# OAUTH (opsional - untuk login dengan Google/GitHub)
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------
# AI PROVIDERS (minimal 1 harus diisi)
# -----------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."    # opsional

# -----------------------------------------------------------------------
# STORAGE - MinIO (self-hosted) atau AWS S3
# Untuk development: jalankan MinIO via docker-compose
# -----------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ruang-belajar"
S3_REGION="us-east-1"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000/ruang-belajar"

# -----------------------------------------------------------------------
# TRANSCRIPTION (opsional - untuk transkripsi audio/video)
# -----------------------------------------------------------------------
ASSEMBLYAI_API_KEY=""

# -----------------------------------------------------------------------
# WORKER SETTINGS (untuk Railway worker service)
# -----------------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_DEFAULT_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# -----------------------------------------------------------------------
# PRODUCTION ONLY
# -----------------------------------------------------------------------
# DOMAIN="ruang-belajar.com"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="strongpassword"
# POSTGRES_DB="ruang_belajar"
# REDIS_PASSWORD="strongpassword"
# MINIO_ROOT_USER="minioadmin"
# MINIO_ROOT_PASSWORD="strongpassword"
