// =============================================================================
// Prisma Schema for Ruang Belajar
// =============================================================================
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  materials        Material[]
  notes            Note[]
  quizAttempts     QuizAttempt[]
  pomodoroSessions PomodoroSession[]
  xpTransactions   XPTransaction[]
  achievements     UserAchievement[]
  forumPosts       ForumPost[]
  forumComments    ForumComment[]
  forumLikes       ForumLike[]
  notifications    Notification[]
  aiConversations  AIConversation[]
  tutorBookings    TutorBooking[]
  studySessions    StudySession[]
  processingJobs   ProcessingJob[]
  userChallenges UserChallenge[]
  tutor          Tutor?
  analyticsEvents AnalyticsEvent[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

// ==================== PROFILE & GAMIFICATION ====================
model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  avatarUrl        String?
  timezone         String    @default("Asia/Jakarta")
  studyGoalMinutes Int       @default(30)
  streakDays       Int       @default(0)
  longestStreak    Int       @default(0)
  lastStudyDate    DateTime?
  totalXP          Int       @default(0)
  level            Int       @default(1)
  xpToNextLevel    Int       @default(1000)
  settings         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("profiles")
}

model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      XPSource
  referenceId String?
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_transactions")
}

enum XPSource {
  MATERIAL_COMPLETE
  QUIZ_COMPLETE
  QUIZ_PERFECT
  POMODORO_COMPLETE
  DAILY_STREAK
  ACHIEVEMENT_UNLOCK
  CHALLENGE_COMPLETE
  NOTE_CREATE
  FORUM_POST
  FORUM_LIKE_RECEIVED
}

model Achievement {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String
  icon        String
  category    AchievementCategory
  requirement Json
  xpReward    Int                 @default(0)
  isSecret    Boolean             @default(false)
  createdAt   DateTime            @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

enum AchievementCategory {
  STREAK
  QUIZ
  LEARNING
  SOCIAL
  SPECIAL
}

model Challenge {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String
  type        ChallengeType
  target      Int
  xpReward    Int
  badgeReward String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  userChallenges UserChallenge[]

  @@map("challenges")
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  SPECIAL
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

// ==================== MATERIALS & PROCESSING ====================
model Material {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?        @db.Text
  type               MaterialType
  status             MaterialStatus @default(UPLOADED)
  sourceUrl          String?
  duration           Int?
  category           String?
  difficulty         Difficulty     @default(MEDIUM)
  tags               String[]
  estimatedStudyTime Int?
  progress           Int            @default(0)
  isPublic           Boolean        @default(false)
  shareToken         String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?

  mediaFiles     MediaFile[]
  transcript     Transcript?
  summary        Summary?
  notes          Note[]
  quizzes        Quiz[]
  studySessions  StudySession[]
  processingJobs ProcessingJob[]
  pomodoroSessions PomodoroSession[]
  aiConversations  AIConversation[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, createdAt])
  @@map("materials")
}

enum MaterialType {
  VIDEO
  AUDIO
  RECORDING
  LINK
  DOCUMENT
}

enum MaterialStatus {
  UPLOADED
  PROCESSING
  EXTRACTING_AUDIO
  TRANSCRIBING
  ANALYZING
  SUMMARIZING
  GENERATING_QUIZ
  COMPLETED
  FAILED
}

enum Difficulty {
  BASIC
  MEDIUM
  ADVANCED
}

model MediaFile {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  s3Key        String   @unique
  s3Bucket     String
  duration     Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([materialId])
  @@map("media_files")
}

model Transcript {
  id           String   @id @default(cuid())
  materialId   String   @unique
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fullText     String   @db.Text
  language     String   @default("id")
  duration     Int
  wordCount    Int
  confidence   Float?
  provider     String
  providerData Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks TranscriptChunk[]

  @@map("transcripts")
}

model TranscriptChunk {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  index        Int
  startTime    Float
  endTime      Float
  text         String     @db.Text
  speaker      String?
  confidence   Float?
  tokens       Int
  embeddings   Unsupported("vector")?

  @@index([transcriptId, index])
  @@map("transcript_chunks")
}

model Summary {
  id             String     @id @default(cuid())
  materialId     String     @unique
  material       Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title          String
  shortSummary   String     @db.Text
  fullSummary    String     @db.Text
  keyPoints      String[]
  mainConcepts   String[]
  importantTerms Json
  conclusion     String?    @db.Text
  difficulty     Difficulty
  category       String?
  estimatedTime  Int?
  provider       String
  model          String
  tokensUsed     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("summaries")
}

// ==================== NOTES ====================
model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  timestamp  Float?
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, materialId])
  @@map("notes")
}

// ==================== QUIZ ====================
model Quiz {
  id            String     @id @default(cuid())
  materialId    String
  material      Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  difficulty    Difficulty
  questionCount Int
  timeLimit     Int?
  passingScore  Int        @default(70)
  isPublished   Boolean    @default(true)
  generatedBy   String
  provider      String?
  model         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([materialId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  index         Int
  type          QuestionType @default(MULTIPLE_CHOICE)
  question      String       @db.Text
  options       Json
  correctAnswer Int
  explanation   String       @db.Text
  difficulty    Difficulty
  topic         String?
  sourceChunkId String?
  createdAt     DateTime     @default(now())

  answers QuizAnswer[]

  @@index([quizId, index])
  @@map("quiz_questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  correctCount   Int
  totalQuestions Int
  timeSpent      Int
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  isPassed       Boolean

  answers QuizAnswer[]

  @@index([userId, quizId])
  @@index([userId, startedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Int?
  isCorrect      Boolean
  timeSpent      Int
  createdAt      DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// ==================== STUDY SESSIONS & POMODORO ====================
model StudySession {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  type       SessionType
  startedAt  DateTime    @default(now())
  endedAt    DateTime?
  duration   Int
  xpEarned   Int         @default(0)
  metadata   Json?

  @@index([userId, startedAt])
  @@index([userId, materialId])
  @@map("study_sessions")
}

enum SessionType {
  MATERIAL_READ
  QUIZ
  POMODORO
  AI_CHAT
  FLASH_CARD
  SPEED_MATCH
  WORD_SCRAMBLE
}

model PomodoroSession {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId      String?
  material        Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  mode            PomodoroMode
  plannedDuration Int
  actualDuration  Int
  completed       Boolean      @default(false)
  tasks           Json
  startedAt       DateTime     @default(now())
  endedAt         DateTime?

  @@index([userId, startedAt])
  @@map("pomodoro_sessions")
}

enum PomodoroMode {
  WORK
  SHORT_BREAK
  LONG_BREAK
}

// ==================== AI CHAT ====================
model AIConversation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title      String
  model      String
  provider   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String         @db.Text
  tokensUsed     Int?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ==================== FORUM / COMMUNITY ====================
model ForumPost {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String   @db.Text
  category   String
  tags       String[]
  isPinned   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  viewCount  Int      @default(0)
  likeCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments ForumComment[]
  likes    ForumLike[]

  @@index([category, createdAt])
  @@index([userId, createdAt])
  @@map("forum_posts")
}

model ForumComment {
  id        String         @id @default(cuid())
  postId    String
  post      ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumComment[] @relation("CommentReplies")
  content   String         @db.Text
  likeCount Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  likes ForumLike[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("forum_comments")
}

model ForumLike {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("forum_likes")
}

// ==================== TUTOR ====================
model Tutor {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String   @db.Text
  subjects      String[]
  hourlyRate    Int
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  totalSessions Int      @default(0)
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  availabilities TutorAvailability[]
  bookings       TutorBooking[]

  @@map("tutors")
}

model TutorAvailability {
  id          String    @id @default(cuid())
  tutorId     String
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  timezone    String    @default("Asia/Jakarta")
  isRecurring Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?

  @@index([tutorId, dayOfWeek])
  @@map("tutor_availabilities")
}

model TutorBooking {
  id         String        @id @default(cuid())
  studentId  String
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId    String
  tutor      Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject    String
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  meetingUrl String?
  notes      String?
  rating     Int?
  review     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([studentId, startTime])
  @@index([tutorId, startTime])
  @@map("tutor_bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ==================== NOTIFICATIONS ====================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum NotificationType {
  STUDY_REMINDER
  QUIZ_RESULT
  ACHIEVEMENT_UNLOCKED
  FORUM_REPLY
  FORUM_LIKE
  PROCESSING_COMPLETE
  PROCESSING_FAILED
  CHALLENGE_AVAILABLE
  CHALLENGE_COMPLETE
  TUTOR_BOOKING
  TUTOR_REMINDER
  SYSTEM
}

// ==================== PROCESSING JOBS ====================
model ProcessingJob {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type        ProcessingJobType
  status      JobStatus         @default(PENDING)
  priority    Int               @default(0)
  progress    Int               @default(0)
  currentStep String?
  error       String?           @db.Text
  result      Json?
  attempts    Int               @default(0)
  maxAttempts Int               @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, status])
  @@index([materialId, type])
  @@map("processing_jobs")
}

enum ProcessingJobType {
  AUDIO_EXTRACTION
  TRANSCRIPTION
  TRANSCRIPT_CLEANING
  AI_ANALYSIS
  SUMMARY_GENERATION
  QUIZ_GENERATION
  EMBEDDING_GENERATION
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== ANALYTICS EVENTS ====================
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String
  eventData  Json
  sessionId  String?
  materialId String?
  createdAt  DateTime @default(now())

  @@index([userId, eventType, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
